# Bu faylni ".env" deb nusxalang va qiymatlarni to'ldiring (lokal ishga tushirish uchun).
# Fly.io / Render / Railway kabi platformalarda bu qiymatlarni
# "Environment Variables" bo'limida (dashboard orqali) kiritasiz — .env fayl shart emas.

# Tasodifiy va uzun matn bo'lsin (masalan terminalda: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

PORT=3000